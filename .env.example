# --- News (one is enough). Exa is the default: it supports arbitrary historical
# date windows. NewsAPI's free tier only covers roughly the last 30 days.
NEWS_PROVIDER=exa            # exa | newsapi
EXA_API_KEY=
NEWSAPI_API_KEY=

# --- LLM for /chat and movement explanations (optional: without a key the
# endpoints fall back to an extractive, non-LLM answer).
LLM_PROVIDER=anthropic       # anthropic | openai | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=claude-haiku-4-5-20251001   # or gpt-4o-mini

# --- Tuning (defaults shown)
# DATABASE_URL=sqlite:///./data/app.db
# DEFAULT_LOOKBACK_DAYS=90
# DEFAULT_MIN_CHANGE_PCT=2.0
# MAX_NEWS_MOVEMENTS=12      # news-API quota guard: movement days enriched per request
# ARTICLES_PER_CATEGORY=5
